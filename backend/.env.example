# Copy to backend/.env to override. Real environment variables win over this file.

OLLAMA_URL=http://127.0.0.1:11434
SMARTBOOK_MODEL_PRO=qwen3.5:4b
SMARTBOOK_MODEL_LITE=qwen3.5:2b-q4_K_M
SMARTBOOK_MODEL_EMBED=qwen3-embedding:0.6b
SMARTBOOK_NUM_CTX=8192
# Run the embedder on CPU so the chat model keeps the whole GPU (much faster on 4 GB cards)
SMARTBOOK_EMBED_ON_CPU=1

# Retrieval: chunks with cosine distance above this are dropped (distance = 1 - similarity)
SMARTBOOK_RELEVANCE_MAX_DISTANCE=0.68
SMARTBOOK_TOP_K=12
SMARTBOOK_MAX_BOOKS=5
SMARTBOOK_HISTORY_MESSAGES=8

# Moderation L2: block when similarity to a harmful exemplar is at least this
SMARTBOOK_MODERATION_THRESHOLD=0.60
SMARTBOOK_MAX_MESSAGE_CHARS=2000

# Cloud-equivalent prices in USD per 1M tokens (local inference itself is free)
SMARTBOOK_PRICE_PRO_IN=0.10
SMARTBOOK_PRICE_PRO_OUT=0.40
SMARTBOOK_PRICE_LITE_IN=0.05
SMARTBOOK_PRICE_LITE_OUT=0.20
SMARTBOOK_PRICE_EMBED_IN=0.02

# SMARTBOOK_DATA_DIR=./.data
# SMARTBOOK_FAKE_LLM=0   # 1 = deterministic fake model (tests / Playwright)
# SMARTBOOK_AUTOSEED=1   # seed the library from seed/books.json when empty
SMARTBOOK_HOST=127.0.0.1
SMARTBOOK_PORT=8000
